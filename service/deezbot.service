[Unit]
Description=Twitch Deez Nutz Bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
# caps restarts to 5 per minute on startup failure; deploy via sudo systemctl daemon-reload + re-enable (operator step, out of scope for this commit)
StartLimitBurst=5

[Service]
Type=simple
User=s4w3d0ff
WorkingDirectory=/home/s4w3d0ff/Projects/deezbot
ExecStart=/home/s4w3d0ff/Projects/deezbot/service/deezbot
Restart=on-failure
RestartSec=5

Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target
