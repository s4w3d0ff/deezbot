#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"

if [ -f "$SCRIPT_DIR/.env" ]; then
    set -a
    source "$SCRIPT_DIR/.env"
    set +a
else
    echo "ERROR: .env file not found"
    exit 1
fi

if [ ! -x "$SCRIPT_DIR/deez_venv/bin/python3" ]; then
    echo "ERROR: deez_venv interpreter not found; run install.sh"
    exit 1
fi

exec -a deezbot "$SCRIPT_DIR/deez_venv/bin/python3" "$SCRIPT_DIR/src/bot.py"
